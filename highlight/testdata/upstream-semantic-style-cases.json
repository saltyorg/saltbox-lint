[
  {
    "name": "specific_styles_and_fallback",
    "theme": {
      "tokenColors": [
        {
          "scope": "entity.name.type",
          "settings": {
            "foreground": "#112233",
            "fontStyle": "italic"
          }
        }
      ],
      "semanticTokenColors": {
        "*": {
          "underline": true
        },
        "class": {
          "foreground": "#445566",
          "bold": true
        },
        "class:ansible": {
          "italic": false
        }
      }
    },
    "type": "class",
    "modifiers": [],
    "language": "ansible",
    "expected": {
      "foreground": "#445566",
      "bold": true,
      "underline": true,
      "strikethrough": false,
      "italic": false
    }
  },
  {
    "name": "later_equal_score",
    "theme": {
      "tokenColors": [],
      "semanticTokenColors": {
        "property": {
          "foreground": "#112233",
          "italic": true
        },
        "*.definition": {
          "foreground": "#445566"
        }
      }
    },
    "type": "property",
    "modifiers": [
      "definition"
    ],
    "language": "ansible",
    "expected": {
      "foreground": "#445566",
      "italic": true
    }
  },
  {
