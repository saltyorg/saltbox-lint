+// resultStyleMemo reuses theme selection only while one result is built.
+// Themes remain mutable between calls, so this must not live on Highlighter.
+type resultStyleMemo map[*theme.Theme]map[string]ast.TokenStyle
+
+func newResultStyleMemo() resultStyleMemo {
+	return make(resultStyleMemo)
+}
+
+func (m resultStyleMemo) resolve(thm *theme.Theme, scopes []string, key string) ast.TokenStyle {
+	styles := m[thm]
+	if style, ok := styles[key]; ok {
+		return style
+	}
+	if styles == nil {
+		styles = make(map[string]ast.TokenStyle)
+		m[thm] = styles
+	}
+	style := resolveStyle(thm, scopes)
+	styles[key] = style
+	return style
+}
+
+// scopeStackKey preserves every scope boundary and byte in order. A plain
+// separator join is ambiguous because scope strings are not restricted here.
+func scopeStackKey(scopes []string) string {
+	size := len(scopes) * binary.MaxVarintLen64
+	for _, scope := range scopes {
+		size += len(scope)
+	}
+	key := make([]byte, 0, size)
+	for _, scope := range scopes {
+		key = binary.AppendUvarint(key, uint64(len(scope)))
+		key = append(key, scope...)
+	}
+	return string(key)
+}
