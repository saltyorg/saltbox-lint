+func completeLineTokens(line []byte, tokens []Token) bool {
+	if len(line) == 0 {
+		return len(tokens) == 0
+	}
+	position := 0
+	for _, token := range tokens {
+		if token.Start != position || token.End <= token.Start || token.End > len(line) {
+			return false
+		}
+		position = token.End
+	}
+	return position == len(line)
 }
 
